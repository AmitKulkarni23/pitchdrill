{
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "bun"
    ],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "bin",
    "lib",
    "test",
    "../backend/src/routes.ts"
  ]
}
